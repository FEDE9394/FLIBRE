<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.futbollibre" name="Fútbol Libre TV" version="1.0.0" provider-name="Antigravity">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.requests" version="2.22.0"/>
    <import addon="script.module.beautifulsoup4" version="4.6.3"/>
    <import addon="script.module.inputstreamhelper" version="0.5.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="es">Ver Fútbol Libre TV en Kodi</summary>
    <description lang="es">Addon de video para ver partidos de fútbol en vivo y canales de deporte desde futbollibre.ad.</description>
    <platform>all</platform>
    <assets>
      <icon>resources/media/icons/icon.png</icon>
      <fanart>resources/media/fanart/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
