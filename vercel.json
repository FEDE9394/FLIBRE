{
  "version": 2,
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/api"
    },
    {
      "source": "/catalog/:path*",
      "destination": "/api"
    },
    {
      "source": "/meta/:path*",
      "destination": "/api"
    },
    {
      "source": "/stream/:path*",
      "destination": "/api"
    }
  ]
}